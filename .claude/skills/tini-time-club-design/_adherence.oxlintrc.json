{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/display/**",
              "components/domain/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/marketing_site/**",
              "ui_kits/mobile_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Figtree, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBarAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|key|ref|className|style|children)$/]",
        "message": "<AppBarAction> doesn't accept that prop. Declared props: icon, label, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|chartreuse|purple|hot|outline|muted)$/]",
        "message": "<Badge> tone must be one of 'green' | 'chartreuse' | 'purple' | 'hot' | 'outline' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|area|distance|rating|openNow|regular|image|layout|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BarCard> doesn't accept that prop. Declared props: name, area, distance, rating, openNow, regular, image, layout, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BarCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|tile)$/]",
        "message": "<BarCard> layout must be one of 'row' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BentoGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|columns|gap|style|key|ref|className|style|children)$/]",
        "message": "<BentoGrid> doesn't accept that prop. Declared props: children, columns, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|onClose|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, title, children, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|icon|iconAfter|block|disabled|type|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, tone, size, icon, iconAfter, block, disabled, type, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|highlight|secondary|ghost|onInk)$/]",
        "message": "<Button> tone must be one of 'primary' | 'highlight' | 'secondary' | 'ghost' | 'onInk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|interactive|padding|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, interactive, padding, onClick, style."
