# Copy to .env.local and fill in real values. Never commit real keys.
APP_ENV=development
# Optional: target another backend without changing the native app identity.
BACKEND_ENV=development

# Google Maps — Places web-service key (inlined into the client bundle; restrict to Places API)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps — native SDK keys, read by app.config.ts at build time
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — client DSN is safe to expose; leave empty to disable reporting.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Local simulator smoke testing only. Keep these off by default.
EXPO_PUBLIC_SENTRY_ENABLE_OUTSIDE_PROD=0
EXPO_PUBLIC_SENTRY_SEND_STARTUP_TEST_EVENT=0

# NOTE: The Expo push access token is a SERVER secret. It lives only in
# Supabase edge-function secrets (EXPO_ACCESS_TOKEN) — never in this file.
