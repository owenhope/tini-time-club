{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "ios",
    "android",
    // Deno edge functions: different runtime and globals, typechecked by the
    // Supabase CLI rather than the app's TypeScript config.
    "supabase/functions",
    // The admin web app is its own Next.js project with its own tsconfig.
    "admin"
  ]
}
