{
  "name": "tini-time-club",
  "main": "expo-router/entry",
  "version": "4.0.1",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "npx eas-cli env:exec development \"env -u EXPO_ACCESS_TOKEN EXPO_NO_DOTENV=1 APP_ENV=development BACKEND_ENV=development npx expo start --dev-client --clear\"",
    "start:prod": "npx eas-cli env:exec production \"env -u EXPO_ACCESS_TOKEN EXPO_NO_DOTENV=1 APP_ENV=development BACKEND_ENV=production npx expo start --dev-client --clear --port 8082\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:prod": "npx eas-cli env:exec production \"env -u EXPO_ACCESS_TOKEN EXPO_NO_DOTENV=1 APP_ENV=development BACKEND_ENV=production npx expo run:ios --port 8082\"",
    "web": "expo start --web",
    "test": "jest --silent",
    "test:watch": "jest --watchAll",
    "screenshots:seed": "node scripts/screenshots/seed-app-store-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run format:check && npm run lint && npm test",
    "release:testflight": "npx eas-cli build --profile production --platform ios --auto-submit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.47.16",
    "aes-js": "^3.1.2",
    "bad-words": "^4.0.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.14",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.12",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.11",
    "expo-image-picker": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.11",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-tracking-transparency": "~57.0.1",
    "expo-updates": "~57.0.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-map-clustering": "^3.4.2",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "private": true
}
