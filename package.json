{
  "name": "tini-time-club",
  "main": "expo-router/entry",
  "version": "5.0.0",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "npx eas-cli env:exec development \"env -u EXPO_ACCESS_TOKEN APP_ENV=development BACKEND_ENV=development npx expo start --dev-client --clear\"",
    "start:prod": "npx eas-cli env:exec production \"env -u EXPO_ACCESS_TOKEN EXPO_NO_DOTENV=1 APP_ENV=development BACKEND_ENV=production npx expo start --dev-client --clear --port 8082\"",
    "sim:vancouver": "xcrun simctl location booted set 49.2827,-123.1207",
    "ios": "expo run:ios",
    "android": "npx eas-cli env:exec development \"env -u EXPO_ACCESS_TOKEN APP_ENV=development BACKEND_ENV=development npx expo run:android\"",
    "build:android:dev": "npx eas-cli build --profile android-development --platform android",
    "build:android:preview": "npx eas-cli build --profile android-preview --platform android",
    "ios:prod": "npx eas-cli env:exec production \"env -u EXPO_ACCESS_TOKEN EXPO_NO_DOTENV=1 APP_ENV=development BACKEND_ENV=production npx expo run:ios --port 8082\"",
    "web": "expo start --web",
    "test": "jest --silent",
    "test:watch": "jest --watchAll",
    "screenshots:seed": "node scripts/screenshots/seed-app-store-screenshots.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run format:check && npm run lint && npm test",
    "release:testflight": "npx eas-cli build --profile production --platform ios --auto-submit",
    "release:android": "npx eas-cli build --profile production --platform android --auto-submit"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.47.16",
    "aes-js": "^3.1.2",
    "bad-words": "^4.0.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-tracking-transparency": "~58.1.0",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.88.1",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-map-clustering": "^3.4.2",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "supercluster": "^7.1.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/supercluster": "^7.1.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
